<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Jellyfin.Plugin.ShowOrganizer</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.ShowOrganizer</RootNamespace>
    <BuildYamlPath>$(MSBuildThisFileDirectory)../../build.yaml</BuildYamlPath>
    <BuildYamlContent>$([System.IO.File]::ReadAllText($(BuildYamlPath)))</BuildYamlContent>
    <VersionPattern>version:\s*["']?([^"'\r\n]+)["']?</VersionPattern>
    <ParsedVersion>$([System.Text.RegularExpressions.Regex]::Match($(BuildYamlContent), $(VersionPattern)).Groups[1].Value.Trim())</ParsedVersion>
    <Version>$(ParsedVersion)</Version>
    <AssemblyVersion>$(ParsedVersion)</AssemblyVersion>
    <FileVersion>$(ParsedVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="TMDbLib" Version="3.0.0" />
  </ItemGroup>

</Project>
